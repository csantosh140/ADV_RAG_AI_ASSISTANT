# LLM Configuration
# Options: openai, groq, google, ollama, mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Model Selection
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Embedding Configuration
# Options: all-MiniLM-L6-v2, text-embedding-3-small, etc.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Ingestion & Chunking Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Retrieval & Reranking
RETRIEVAL_TOP_K=10
RERANK_TOP_K=4
HYBRID_ALPHA=0.5
SIMILARITY_THRESHOLD=0.35

# Storage Paths
DATA_DIR=./data
FAISS_INDEX_DIR=./data/faiss_indexes
RAW_DOCS_DIR=./data/raw_documents

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_API_URL=http://localhost:8000
FRONTEND_PORT=8501
LOG_LEVEL=INFO
